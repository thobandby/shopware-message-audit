{
  "name": "mh/dashboard",
  "description": "Shopware 6 plugin and release workspace for Status Audit, including local quality gates and E2E verification",
  "type": "project",
  "homepage": "https://baumann-it-dienstleistungen.de",
  "authors": [
    {
      "name": "Thorsten Baumann",
      "email": "info@baumann-it-dienstleistungen.de",
      "homepage": "https://baumann-it-dienstleistungen.de",
      "role": "Author"
    }
  ],
  "require": {
    "php": "^8.1",
    "symfony/messenger": "^6.0 || ^7.0",
    "symfony/event-dispatcher": "^6.0 || ^7.0",
    "symfony/routing": "^6.0 || ^7.0",
    "symfony/http-foundation": "^6.0 || ^7.0",
    "symfony/framework-bundle": "^6.0 || ^7.0",
    "shopware/core": "^6.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpdoc-parser": "^2.0",
    "nunomaduro/phpinsights": "^2.0",
    "bamarni/composer-bin-plugin": "^1.9"
  },
  "scripts": {
    "cs-fix": "vendor/bin/php-cs-fixer fix --sequential",
    "phpstan": "vendor/bin/phpstan analyse --no-progress --debug",
    "phpinsights": "vendor/bin/phpinsights --config-path=phpinsights.php --disable-security-check --no-interaction --ansi",
    "admin:build-local": "bash scripts/build-administration-local.sh",
    "admin:cleanup-dev-tools": "bash scripts/cleanup-shopware-dev-tools.sh",
    "e2e-local": "bash scripts/run-local-e2e.sh",
    "test": "vendor/bin/phpunit tests",
    "quality:all": "bash scripts/run-quality.sh",
    "release:zip": "bash scripts/build-release.sh",
    "quality": [
      "@cs-fix",
      "@phpstan",
      "@phpinsights",
      "@test"
    ]
  },
  "autoload": {
    "psr-4": {
      "MessengerHistoryDashboard\\": "plugin/MessengerHistoryDashboard/src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true,
      "bamarni/composer-bin-plugin": true
    }
  },
  "support": {
    "email": "info@baumann-it-dienstleistungen.de",
    "source": "https://baumann-it-dienstleistungen.de",
    "docs": "https://baumann-it-dienstleistungen.de"
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": true,
      "forward-command": false
    }
  }
}
